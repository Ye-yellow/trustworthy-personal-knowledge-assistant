# P0 default: local WSL sub2api through its OpenAI-compatible endpoint.
TRUSTKB_LLM_PROVIDER=sub2api
TRUSTKB_LLM_MODEL=gpt-5.5
TRUSTKB_LLM_BASE_URL=http://localhost:8080/v1
TRUSTKB_LLM_API_KEY=replace-with-your-local-sub2api-key
TRUSTKB_LLM_TIMEOUT_SECONDS=120
TRUSTKB_LLM_MAX_RETRIES=2

# Optional per-purpose model overrides. Blank values inherit TRUSTKB_LLM_MODEL.
TRUSTKB_LLM_EXTRACTOR_MODEL=
TRUSTKB_LLM_VERIFIER_MODEL=
TRUSTKB_LLM_CURATION_MODEL=
TRUSTKB_LLM_ANSWER_MODEL=

# L1 local SQLite control plane. Runtime initialization is Alembic-only.
TRUSTKB_DATABASE_URL=sqlite+aiosqlite:///./data/trustworthy_kb.db
TRUSTKB_DATABASE_BUSY_TIMEOUT_MS=5000

# L2 manual Obsidian ingestion. Keep the real Vault ID and path in local environment only.
TRUSTKB_INGESTION_VAULT_ID=replace-with-your-local-vault-id
TRUSTKB_INGESTION_VAULT_PATH=./local-vault
TRUSTKB_INGESTION_SNAPSHOT_ROOT=./storage/source-snapshots
TRUSTKB_INGESTION_CHECKPOINT_PATH=./storage/checkpoints/ingestion.sqlite
TRUSTKB_INGESTION_OBSIDIAN_EXECUTABLE=obsidian
TRUSTKB_INGESTION_ALLOWED_ROOTS=["."]
TRUSTKB_INGESTION_EXCLUDED_ROOTS=[".obsidian",".trash","_AI","attachments"]
TRUSTKB_INGESTION_MAX_MARKDOWN_BYTES=5242880
TRUSTKB_INGESTION_STABLE_READ_INTERVAL_MS=250
TRUSTKB_INGESTION_STABLE_READ_ATTEMPTS=3
TRUSTKB_INGESTION_CLI_TIMEOUT_SECONDS=30
TRUSTKB_INGESTION_CLI_OUTPUT_LIMIT_BYTES=4194304
