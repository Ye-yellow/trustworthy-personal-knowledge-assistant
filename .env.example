# P0 default: local WSL sub2api through its OpenAI-compatible endpoint.
TRUSTKB_LLM_PROVIDER=sub2api
TRUSTKB_LLM_MODEL=gpt-5.5
TRUSTKB_LLM_BASE_URL=http://localhost:8080/v1
TRUSTKB_LLM_API_KEY=replace-with-your-local-sub2api-key
TRUSTKB_LLM_TIMEOUT_SECONDS=120
TRUSTKB_LLM_MAX_RETRIES=2

# Optional per-purpose model overrides. Blank values inherit TRUSTKB_LLM_MODEL.
TRUSTKB_LLM_EXTRACTOR_MODEL=
TRUSTKB_LLM_VERIFIER_MODEL=
TRUSTKB_LLM_CURATION_MODEL=
TRUSTKB_LLM_ANSWER_MODEL=

# L3 provider-neutral candidate discovery. Defaults to the LLM model when blank.
TRUSTKB_SEARCH_PROVIDER=sub2api
TRUSTKB_SEARCH_MODEL=gpt-5.5
TRUSTKB_SEARCH_TIMEOUT_SECONDS=120
TRUSTKB_SEARCH_MAX_SEARCHES_PER_CLAIM=4
TRUSTKB_SEARCH_MAX_CANDIDATES_PER_CLAIM=8

# L3 deterministic governance. Trusted domains must be explicit JSON arrays.
TRUSTKB_GOVERNANCE_POLICY_VERSION=l3-v1
TRUSTKB_GOVERNANCE_EXTRACTOR_VERSION=claim-extractor-v1
TRUSTKB_GOVERNANCE_VERIFIER_VERSION=evidence-verifier-v1
TRUSTKB_GOVERNANCE_SEARCH_POLICY_VERSION=search-v1
TRUSTKB_GOVERNANCE_T1_DOMAINS=[]
TRUSTKB_GOVERNANCE_T2_DOMAINS=[]
TRUSTKB_GOVERNANCE_SOURCE_SNAPSHOT_ROOT=./storage/source-snapshots
TRUSTKB_GOVERNANCE_EVIDENCE_SNAPSHOT_ROOT=./storage/evidence-snapshots
TRUSTKB_GOVERNANCE_CHECKPOINT_PATH=./storage/checkpoints/governance.sqlite
TRUSTKB_GOVERNANCE_MAX_CLAIMS_PER_DOCUMENT=100
TRUSTKB_GOVERNANCE_MAX_EXTRACTION_CHARACTERS=200000
TRUSTKB_GOVERNANCE_MAX_CONCURRENCY=4

# Independent HTTPS fetcher: no proxies, cookies, JavaScript, or implicit redirects.
TRUSTKB_FETCH_TIMEOUT_SECONDS=15
TRUSTKB_FETCH_MAX_RAW_BYTES=5242880
TRUSTKB_FETCH_MAX_DECODED_BYTES=10485760
TRUSTKB_FETCH_MAX_REDIRECTS=3
TRUSTKB_FETCH_ALLOWED_MEDIA_TYPES=["text/html","text/plain","application/pdf","application/json"]

# L1 local SQLite control plane. Runtime initialization is Alembic-only.
TRUSTKB_DATABASE_URL=sqlite+aiosqlite:///./data/trustworthy_kb.db
TRUSTKB_DATABASE_BUSY_TIMEOUT_MS=5000

# L2 manual Obsidian ingestion. Keep the real Vault ID and path in local environment only.
TRUSTKB_INGESTION_VAULT_ID=replace-with-your-local-vault-id
TRUSTKB_INGESTION_VAULT_PATH=./local-vault
TRUSTKB_INGESTION_SNAPSHOT_ROOT=./storage/source-snapshots
TRUSTKB_INGESTION_CHECKPOINT_PATH=./storage/checkpoints/ingestion.sqlite
TRUSTKB_INGESTION_OBSIDIAN_EXECUTABLE=obsidian
TRUSTKB_INGESTION_ALLOWED_ROOTS=["."]
TRUSTKB_INGESTION_EXCLUDED_ROOTS=[".obsidian",".trash","_AI","attachments"]
TRUSTKB_INGESTION_MAX_MARKDOWN_BYTES=5242880
TRUSTKB_INGESTION_STABLE_READ_INTERVAL_MS=250
TRUSTKB_INGESTION_STABLE_READ_ATTEMPTS=3
TRUSTKB_INGESTION_CLI_TIMEOUT_SECONDS=30
TRUSTKB_INGESTION_CLI_OUTPUT_LIMIT_BYTES=4194304

# L4 generated-note publication. Keep the real Vault path only in local .env.
TRUSTKB_PUBLICATION_VAULT_PATH=./local-vault
TRUSTKB_PUBLICATION_SNAPSHOT_ROOT=./storage/publication-snapshots
TRUSTKB_PUBLICATION_STAGING_ROOT=_AI/Staging
TRUSTKB_PUBLICATION_VERSIONS_ROOT=_AI/Versions
TRUSTKB_PUBLICATION_NOTE_ROOT=40-Concepts
TRUSTKB_PUBLICATION_PROMPT_VERSION=curation-v1
TRUSTKB_PUBLICATION_CHUNKER_VERSION=markdown-v1
TRUSTKB_PUBLICATION_SCHEMA_VERSION=milvus-hybrid-v1
TRUSTKB_PUBLICATION_MAX_MARKDOWN_BYTES=5242880

# L4 local hybrid retrieval. Milvus is bound to loopback by deploy/milvus/compose.yaml.
TRUSTKB_RETRIEVAL_VECTOR_PROVIDER=milvus
TRUSTKB_RETRIEVAL_MILVUS_URI=http://127.0.0.1:19530
TRUSTKB_RETRIEVAL_MILVUS_TOKEN=
TRUSTKB_RETRIEVAL_COLLECTION_PREFIX=trustworthy_kb_chunks_g
TRUSTKB_RETRIEVAL_CONSISTENCY=Bounded
TRUSTKB_RETRIEVAL_TIMEOUT_SECONDS=30
TRUSTKB_RETRIEVAL_EMBEDDING_PROVIDER=bge
TRUSTKB_RETRIEVAL_EMBEDDING_MODEL=BAAI/bge-m3
TRUSTKB_RETRIEVAL_EMBEDDING_DIMENSION=1024
TRUSTKB_RETRIEVAL_EMBEDDING_DEVICE=
TRUSTKB_RETRIEVAL_EMBEDDING_BATCH_SIZE=16
TRUSTKB_RETRIEVAL_RERANKER_PROVIDER=bge
TRUSTKB_RETRIEVAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
TRUSTKB_RETRIEVAL_RERANKER_DEVICE=
TRUSTKB_RETRIEVAL_RERANKER_BATCH_SIZE=8
TRUSTKB_RETRIEVAL_MODEL_CACHE_ROOT=./storage/model-cache
TRUSTKB_RETRIEVAL_ALLOW_BM25_ONLY=false
TRUSTKB_RETRIEVAL_RRF_K=60

# L5 trusted answers and loopback-only API. Verified answer snapshots stay local and private.
TRUSTKB_ANSWER_PROMPT_VERSION=answer-v1
TRUSTKB_ANSWER_CITATION_VERIFIER_VERSION=answer-citation-v1
TRUSTKB_ANSWER_MAX_QUESTION_CHARACTERS=4000
TRUSTKB_ANSWER_MAX_ANSWER_CLAIMS=12
TRUSTKB_ANSWER_MAX_CLAIM_CHARACTERS=1000
TRUSTKB_ANSWER_MIN_EVIDENCE_COUNT=1
TRUSTKB_ANSWER_DEFAULT_TOP_K=5
TRUSTKB_ANSWER_SNAPSHOT_ROOT=./storage/answer-snapshots
TRUSTKB_ANSWER_API_HOST=127.0.0.1
TRUSTKB_ANSWER_API_PORT=8765
